<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- usesCleartextTraffic: la PC contesta por HTTP en el puerto 8765, pero
         solo dentro de Tailscale, que ya va cifrado (WireGuard). La app se niega
         a conectarse a cualquier dirección que no sea de Tailscale (malla.dart). -->
    <!-- allowBackup false: el respaldo de Android se lleva los ajustes cifrados
         pero no su llave, y al restaurarlos no se podrían leer. -->
    <application
        android:label="Sokari"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Para abrirla como asistente (por ejemplo, manteniendo presionado
                 el botón de inicio o de encendido, según el celular). -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- El aviso si Flutter no alcanza a dibujar (MainActivity.kt): una pantalla
             de Android sola, que se ve aunque el dibujo de Flutter falle. -->
        <activity
            android:name=".AvisoActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Android 11+: para ver el reconocimiento de voz y la lectura en voz alta del
         sistema, y el ProcessTextPlugin de Flutter. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
