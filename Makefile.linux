# Sokari para Linux (Ubuntu 24.04+ y Fedora 44):  make -f Makefile.linux
# Necesita gcc, make, pkg-config y las cabeceras de libcurl:
#   Ubuntu: sudo apt install build-essential pkg-config libcurl4-openssl-dev libpulse-dev libgtk-3-dev
#           libayatana-appindicator3-dev
#   Fedora: sudo dnf install gcc make pkgconf-pkg-config libcurl-devel pulseaudio-libs-devel gtk3-devel
#           libayatana-appindicator-gtk3-devel

CC ?= gcc
PKGS := libcurl libpulse libpulse-simple gio-2.0 gio-unix-2.0 gtk+-3.0 ayatana-appindicator3-0.1
CFLAGS := -std=gnu11 -O2 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -D_GNU_SOURCE \
          -Isrc -Isrc/linux/include -MMD -MP $(shell pkg-config --cflags $(PKGS))
LIBS := $(shell pkg-config --libs $(PKGS)) -lm -lpthread

# Del código compartido con Windows, lo que no depende del sistema. Lo propio
# de Linux está en src/linux/ (y src/linux/include/windows.h da los hilos y
# candados con la misma forma que en Windows).
SHARED := agent audio_common calc config groq http_common intents keys log memory mesh mesh_devices sounds_common sphere \
          skills skills_calc skills_notes skills_timers skills_user skills_weather \
          tool_policy tools tools_common tools_memory tools_web tts_common util vad voice wakeword nn_generic nn_avx2
# Detector de voz de WebRTC (C puro, licencia BSD): ver src/third_party/webrtc_vad.
VAD_SRC := $(wildcard src/third_party/webrtc_vad/webrtc/common_audio/vad/*.c) \
           $(wildcard src/third_party/webrtc_vad/webrtc/common_audio/signal_processing/*.c)
SRC := $(addprefix src/,$(addsuffix .c,$(SHARED))) src/third_party/cJSON.c $(VAD_SRC) $(wildcard src/linux/*.c)
OBJ := $(patsubst src/%.c,build-linux/obj/%.o,$(SRC)) build-linux/obj/linux/recursos.o
MAIN_OBJ := build-linux/obj/linux/main_linux.o
LIB_OBJ := $(filter-out $(MAIN_OBJ),$(OBJ))
OUT ?= build-linux/sokari

# El modelo de "Hey Sokari" entra solo si res/hey_sokari.jww existe.
HEY_SOKARI := $(wildcard res/hey_sokari.jww)
RES_FILES := res/tools.json res/system_prompt.txt res/wakeword.bin res/sokari.png $(HEY_SOKARI)

# Las pruebas que ya corren en Linux (las demás llegan con cada parte).
LINUX_TESTS := test_aparecer test_comandos test_skills test_confirmacion test_escucha test_malla test_resources test_respaldos test_teclado test_util test_voice test_wakeword test_groq
# Y las que son solo de Linux (tests/linux/).
LINUX_ONLY_TESTS := $(patsubst tests/linux/%.c,%,$(wildcard tests/linux/*.c))
TESTS := $(addprefix build-linux/tests/,$(LINUX_TESTS) $(LINUX_ONLY_TESTS))

.PHONY: all clean tests prueba-gnome install

all: $(OUT)

$(OUT): $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) -o $@ $^ $(LIBS)

build-linux/obj/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Código de terceros tal cual: sus avisos no son nuestros (y la CI falla con cualquiera).
build-linux/obj/third_party/webrtc_vad/%.o: CFLAGS += -Isrc/third_party/webrtc_vad -DWEBRTC_POSIX -w
build-linux/obj/vad.o: CFLAGS += -Isrc/third_party/webrtc_vad
build-linux/obj/nn_avx2.o: CFLAGS += -O3 -mavx2 -mfma
build-linux/obj/nn_generic.o: CFLAGS += -O3

build-linux/obj/linux/recursos.o: src/linux/recursos.S $(RES_FILES)
	@mkdir -p $(dir $@)
	$(CC) -c -Ires $(if $(HEY_SOKARI),-DHAVE_HEY_SOKARI) $< -o $@

tests: $(TESTS)

# Las pruebas arrancan en wmain, como en Windows.
TEST_CFLAGS = $(CFLAGS) -Dwmain=main

build-linux/tests/%: tests/%.c $(LIB_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) -o $@ $^ $(LIBS)

build-linux/tests/%: tests/linux/%.c $(LIB_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) -o $@ $^ $(LIBS)

# Trae su propio Groq y su propio run_tool de mentira (como en Windows).
build-linux/tests/test_confirmacion: tests/test_confirmacion.c \
		$(filter-out build-linux/obj/groq.o build-linux/obj/tools.o,$(LIB_OBJ))
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) -o $@ $^ $(LIBS)

# Lo que va en el paquete (.deb o .rpm): make -f Makefile.linux install DESTDIR=... PREFIX=/usr
PREFIX ?= /usr/local
DESTDIR ?=
EXT := sokari@podselxd.github.io
ICON_SIZES := 16 24 32 48 64 128 256
install: $(OUT)
	install -Dm755 $(OUT) $(DESTDIR)$(PREFIX)/bin/sokari
	install -Dm644 linux/io.github.podselxd.Sokari.desktop $(DESTDIR)$(PREFIX)/share/applications/io.github.podselxd.Sokari.desktop
	for s in $(ICON_SIZES); do \
		install -Dm644 linux/iconos/$$s.png $(DESTDIR)$(PREFIX)/share/icons/hicolor/$${s}x$${s}/apps/io.github.podselxd.Sokari.png; \
	done
	install -Dm644 linux/extension/$(EXT)/metadata.json $(DESTDIR)$(PREFIX)/share/gnome-shell/extensions/$(EXT)/metadata.json
	install -Dm644 linux/extension/$(EXT)/extension.js $(DESTDIR)$(PREFIX)/share/gnome-shell/extensions/$(EXT)/extension.js

# La extensión de GNOME de verdad, con GNOME Shell sin pantalla (necesita
# gnome-shell y GTK 3): make -f Makefile.linux prueba-gnome && sh tests/linux/gnome/probar_extension.sh
GNOME_TESTS := build-linux/tests-gnome
prueba-gnome: $(GNOME_TESTS)/test_gnome_real $(GNOME_TESTS)/ventana_de_prueba

$(GNOME_TESTS)/test_gnome_real: tests/linux/gnome/test_gnome_real.c $(LIB_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) -o $@ $^ $(LIBS)

$(GNOME_TESTS)/ventana_de_prueba: tests/linux/gnome/ventana_de_prueba.c
	@mkdir -p $(dir $@)
	$(CC) -O2 -Wall -Wextra -Wno-unused-parameter -o $@ $< $(shell pkg-config --cflags --libs gtk+-3.0)

clean:
	rm -rf build-linux

-include $(OBJ:.o=.d)
