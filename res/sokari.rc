#include <winver.h>
#include "../src/resource.h"

IDI_SOKARI ICON "sokari.ico"
1 24 "sokari.manifest"

IDR_TOOLS_JSON RCDATA "tools.json"
IDR_SYSTEM_PROMPT RCDATA "system_prompt.txt"
IDR_WAKEWORD RCDATA "wakeword.bin"
#ifdef HAVE_HEY_SOKARI
IDR_HEY_SOKARI RCDATA "hey_sokari.jww"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,7,3,0
PRODUCTVERSION 2,7,3,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080a04b0"
        BEGIN
            VALUE "CompanyName", "podselxd"
            VALUE "FileDescription", "Sokari - asistente de voz"
            VALUE "FileVersion", "2.7.3"
            VALUE "InternalName", "Sokari"
            VALUE "OriginalFilename", "Sokari.exe"
            VALUE "ProductName", "Sokari"
            VALUE "ProductVersion", "2.7.3"
            VALUE "LegalCopyright", "Modelo de wake word: openWakeWord (CC BY-NC-SA 4.0)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x080a, 1200
    END
END
